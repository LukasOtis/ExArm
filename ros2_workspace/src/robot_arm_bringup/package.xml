<?xml version="1.0"?>
<package format="3">
  <name>robot_arm_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and test utilities for the two-DoF ROS 2 arm.</description>
  <maintainer email="dev@exarm.local">ExArm Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>rviz2</depend>
  <depend>robot_arm_description</depend>
  <depend>grbl_bridge</depend>
  <depend>trajectory_msgs</depend>
  <depend>builtin_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
