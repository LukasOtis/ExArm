<?xml version="1.0"?>
<robot name="robot_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Geometry -->
  <xacro:property name="base_radius" value="0.10"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="stage_radius" value="0.08"/>
  <xacro:property name="stage_thickness" value="0.02"/>
  <xacro:property name="arm_length" value="0.40"/>
  <xacro:property name="arm_width" value="0.05"/>
  <xacro:property name="arm_thickness" value="0.04"/>
  <xacro:property name="tool_length" value="0.05"/>
  <xacro:property name="tool_radius" value="0.01"/>

  <!-- Mass approximations (kg) -->
  <xacro:property name="base_mass" value="8.0"/>
  <xacro:property name="stage_mass" value="3.0"/>
  <xacro:property name="arm_mass" value="1.2"/>
  <xacro:property name="tool_mass" value="0.2"/>

  <!-- Joint limits -->
  <xacro:property name="base_rotation_limit" value="3.14159"/>
  <xacro:property name="pivot_min_deg" value="25.0"/>
  <xacro:property name="pivot_max_deg" value="130.0"/>
  <xacro:property name="pivot_min_rad" value="${pivot_min_deg * pi / 180.0}"/>
  <xacro:property name="pivot_max_rad" value="${pivot_max_deg * pi / 180.0}"/>
  <xacro:property name="pivot_mid_rad" value="${0.5 * (pivot_min_rad + pivot_max_rad)}"/>
  <xacro:property name="pivot_span_half" value="${0.5 * (pivot_max_rad - pivot_min_rad)}"/>
  <xacro:property name="pivot_lower" value="${-pivot_span_half}"/>
  <xacro:property name="pivot_upper" value="${pivot_span_half}"/>

  <!-- Helpers -->
  <xacro:macro name="inertial_box" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass / 12.0 * (y*y + z*z)}"
        iyy="${mass / 12.0 * (x*x + z*z)}"
        izz="${mass / 12.0 * (x*x + y*y)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass / 12.0 * (3 * radius*radius + length*length)}"
        iyy="${mass / 12.0 * (3 * radius*radius + length*length)}"
        izz="${0.5 * mass * radius*radius}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="BaseGrey">
        <color rgba="0.2 0.2 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="${base_mass}" radius="${base_radius}" length="${base_height}"/>
  </link>

  <!-- Rotating stage -->
  <joint name="base_rotation" type="continuous">
    <parent link="base_link"/>
    <child link="rotating_stage"/>
    <origin xyz="0 0 ${base_height/2 + stage_thickness/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${base_rotation_limit}" upper="${base_rotation_limit}" effort="20.0" velocity="1.57"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="rotating_stage">
    <visual>
      <geometry>
        <cylinder radius="${stage_radius}" length="${stage_thickness}"/>
      </geometry>
      <material name="StageBlue">
        <color rgba="0.0 0.25 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${stage_radius}" length="${stage_thickness}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="${stage_mass}" radius="${stage_radius}" length="${stage_thickness}"/>
  </link>

  <!-- Arm pivot located at stage perimeter -->
  <joint name="arm_pivot" type="revolute">
    <parent link="rotating_stage"/>
    <child link="arm_link"/>
    <origin
      xyz="${stage_radius} 0 ${base_height/2 + stage_thickness}"
      rpy="0 ${pivot_mid_rad} 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${pivot_lower}" upper="${pivot_upper}" effort="15.0" velocity="1.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="arm_link">
    <visual>
      <origin xyz="${arm_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_thickness}"/>
      </geometry>
      <material name="ArmOrange">
        <color rgba="0.9 0.45 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${arm_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_thickness}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="${arm_mass}" x="${arm_length}" y="${arm_width}" z="${arm_thickness}"/>
  </link>

  <!-- Tooling stub -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="arm_link"/>
    <child link="end_effector"/>
    <origin xyz="${arm_length} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="end_effector">
    <visual>
      <origin xyz="${tool_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${tool_radius}" length="${tool_length}"/>
      </geometry>
      <material name="ToolBlack">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${tool_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="${tool_radius}" length="${tool_length}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="${tool_mass}" radius="${tool_radius}" length="${tool_length}"/>
  </link>

  <joint name="tool_tip_joint" type="fixed">
    <parent link="end_effector"/>
    <child link="tool_tip"/>
    <origin xyz="${tool_length} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool_tip">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="TipWhite">
        <color rgba="0.95 0.95 0.95 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="0.03" y="0.03" z="0.03"/>
  </link>

</robot>