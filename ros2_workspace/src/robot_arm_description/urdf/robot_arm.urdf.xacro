<?xml version="1.0"?>
<robot name="robot_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Robot Arm Parameters -->
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="link1_length" value="0.3"/>
  <xacro:property name="link2_length" value="0.25"/>
  <xacro:property name="link3_length" value="0.2"/>
  <xacro:property name="linear_actuator_max" value="0.1"/>
  
  <!-- Joint Limits -->
  <xacro:property name="base_rotation_limit" value="3.14159"/>
  <xacro:property name="shoulder_limit" value="1.5708"/>
  <xacro:property name="elbow_limit" value="1.5708"/>
  <xacro:property name="linear_actuator_limit" value="0.1"/>
  <xacro:property name="end_effector_limit" value="3.14159"/>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 1: Base Rotation -->
  <joint name="base_rotation" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${base_rotation_limit}" upper="${base_rotation_limit}" 
           velocity="1.0" effort="10.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="link1">
    <visual>
      <geometry>
        <box size="0.1 0.1 ${link1_length}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 ${link1_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 2: Shoulder Rotation -->
  <joint name="shoulder_rotation" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${shoulder_limit}" upper="${shoulder_limit}" 
           velocity="1.0" effort="10.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="link2">
    <visual>
      <geometry>
        <box size="0.08 0.08 ${link2_length}"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.08 ${link2_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 3: Elbow Rotation -->
  <joint name="elbow_rotation" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${elbow_limit}" upper="${elbow_limit}" 
           velocity="1.0" effort="10.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="link3">
    <visual>
      <geometry>
        <box size="0.06 0.06 ${link3_length}"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.06 ${link3_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 4: Linear Actuator 1 -->
  <joint name="linear_actuator1" type="prismatic">
    <parent link="link3"/>
    <child link="linear_link1"/>
    <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="${linear_actuator_limit}" 
           velocity="0.1" effort="20.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="linear_link1">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 5: Linear Actuator 2 -->
  <joint name="linear_actuator2" type="prismatic">
    <parent link="linear_link1"/>
    <child link="linear_link2"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="${linear_actuator_limit}" 
           velocity="0.1" effort="20.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="linear_link2">
    <visual>
      <geometry>
        <cylinder radius="0.015" length="0.04"/>
      </geometry>
      <material name="purple">
        <color rgba="0.5 0 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.015" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 6: End Effector Rotation -->
  <joint name="end_effector_rotation" type="revolute">
    <parent link="linear_link2"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${end_effector_limit}" upper="${end_effector_limit}" 
           velocity="2.0" effort="5.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="end_effector">
    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- End Effector Tool -->
  <link name="tool">
    <visual>
      <geometry>
        <cylinder radius="0.005" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.005" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="end_effector"/>
    <child link="tool"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

</robot>